# 2.Write a program to check whether two numbers are equal without using comparison operators.

a = int(input("Enter first number: "))
b = int(input("Enter second number: "))
if not a - b:
    print("Numbers are equal")
else:
    print("Numbers are not equal")

# 1. Create a program to find the maximum and minimum of two numbers without using any loops or conditional statements

a = int(input("Enter first number: "))
b = int(input("Enter second number: "))
max = ((a + b) + abs(a-b))//2
min = ((a + b) - abs(a-b))//2
print(f"Minimum: {min}")
print(f"Maximum: {max}")

